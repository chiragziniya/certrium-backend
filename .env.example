# Example environment file (safe to commit)
# Copy to `backend/.env` for local dev, or use `ENV_FILE` to point to a specific env file.

DJANGO_ENV=local
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database
DATABASE_URL=sqlite:///db.sqlite3
# TESTING=True
# TEST_DATABASE_URL=sqlite:///:memory:

# CORS / CSRF
CORS_ALLOW_ALL_ORIGINS=True
# CORS_ALLOWED_ORIGINS=https://localhost:3000
# CSRF_TRUSTED_ORIGINS=https://localhost:3000

# Email (local default is console backend)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
DEFAULT_FROM_EMAIL=no-reply@localhost

# Media upload defaults
DEFAULT_UPLOAD_PROVIDER=LOCAL  # LOCAL | S3 | CLOUDINARY

# Cloudinary (recommended to set as a single URL)
# CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>

# AWS S3 (django-storages)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=
AWS_S3_ENDPOINT_URL=
AWS_DEFAULT_ACL=
AWS_QUERYSTRING_AUTH=True

# Redis / Celery (optional)
REDIS_URL=redis://localhost:6379/0
